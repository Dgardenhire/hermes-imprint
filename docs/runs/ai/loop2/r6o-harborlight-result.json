          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_0e2da1c834c4"
          },
          {
            "ref": "P5",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_0e2da1c834c4"
          }
        ],
        "suggestion": true
      },
      {
        "text": "Enrollment grew from 936 to 1,148 learners, yet 287 adults still wait an average of nine weeks. Will one more site keep up with that growth?",
