          "length": "A short deck"
        }
      }
    ],
    "questions": [
      {
        "text": "The sixth site would serve 180 more learners a year, but 287 adults are waiting. Is halving the waitlist enough when most of the wait is at Eastgate and Riverside?",
        "chips": [
          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_7f63022d4da3"
          },
          {
            "ref": "P5",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_7f63022d4da3"
          }
        ],
        "suggestion": true
      },
      {
        "text": "Enrollment grew by 212 learners, from 936 to 1,148, with 11 full-time staff. Will two more site coordinators keep up as more learners come in?",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
