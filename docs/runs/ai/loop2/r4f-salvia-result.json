        ],
        "heading": "Fund Salvia Kitchen to keep local catering growing",
        "text": "Ana and Tomas built a commercial kitchen from neighborhood party cooking. It buys from nearby farms.",
        "cta": "Back Salvia Kitchen as it caters local events with local produce"
      }
    ],
