  "case": "Harborlight enrolled 1,148 adult learners in FY2026, up from 936, and 287 adults were still waiting at year end, so we ask funders to help open a sixth site at the Eastgate branch library for $190,000 more a year.",
  "argument": {
    "reader": "Funders whom Harborlight board members meet decide whether to pay for a sixth adult learning site at the Eastgate branch library.",
    "instructions": [
      {
        "said": "Board members asked for a short deck they can use with funders when they talk about the sixth site.",
        "refs": [
          "P8"
        ],
        "met_by": "ask"
      }
    ],
    "lead": {
      "heading": "Enrollment grew to 1,148 learners, and 287 adults are still waiting",
      "type": "exhibit",
      "evidence": [
        {
          "text": "Harborlight enrolled 1,148 adult learners in FY2026 across five neighborhood sites.",
          "refs": [
            "P1"
          ]
        },
        {
          "text": "That is up from 936 learners the year before, 212 more.",
          "refs": [
            "P1"
          ]
        },
        {
          "text": "At year end, 287 adults were on the waitlist, most at the Eastgate and Riverside sites.",
          "refs": [
            "P4"
          ]
        },
        {
          "text": "The average wait was nine weeks.",
          "refs": [
            "P4"
          ]
        }
      ]
    },
    "points": [
      {
        "heading": "Learners who stay make real gains",
        "type": "figures",
        "evidence": [
          {
            "text": "68 percent of learners who stayed at least 12 weeks gained one or more CASAS reading levels.",
            "refs": [
              "P1"
            ]
          },
          {
            "text": "71 learners earned a high school equivalency credential, the most in Harborlight's history.",
            "refs": [
              "P1"
            ]
          },
          {
            "text": "412 learners were working toward a high school equivalency credential in FY2026.",
            "refs": [
              "P1"
            ]
          },
          {
            "text": "389 learners were English language learners.",
            "refs": [
              "P1"
            ]
          }
        ]
      },
      {
        "heading": "Reading changes family life",
        "type": "quote",
        "evidence": [
          {
            "text": "“I read my granddaughter a bedtime story for the first time this spring,” said a learner at the Riverside site.",
            "refs": [
              "P5"
            ]
          }
        ]
      },
      {
        "heading": "Volunteers stretch every dollar to $1,237 per learner",
        "type": "figures",
        "evidence": [
          {
            "text": "214 volunteer tutors gave 9,870 tutoring hours in FY2026.",
            "refs": [
              "P2"
            ]
          },
          {
            "text": "The average tutor stayed 14 months.",
            "refs": [
              "P2"
            ]
          },
          {
            "text": "The cost per learner was $1,237.",
            "refs": [
              "P3"
            ]
          },
          {
            "text": "Program costs were 81 percent of spending.",
            "refs": [
              "P3"
            ]
          }
        ]
      },
      {
        "heading": "A sixth site at Eastgate meets the wait where it is longest",
        "type": "comparison",
        "evidence": [
          {
            "text": "Sites: five neighborhood sites today; the plan adds a sixth at the Eastgate branch library.",
            "refs": [
              "P1",
              "P5"
            ]
          },
          {
            "text": "Site coordinators: four today; the plan adds two.",
            "refs": [
              "P2",
              "P5"
            ]
          },
          {
            "text": "Learners: staff estimate the sixth site would serve 180 more a year.",
            "refs": [
              "P5"
            ]
          },
          {
            "text": "Waitlist: 287 adults today; staff estimate the site would cut it in half.",
            "refs": [
              "P4",
              "P5"
            ]
          }
        ]
      }
    ],
    "counter": {
      "objection": "Can Harborlight really pay to run another site year after year?",
      "heading": "Harborlight already draws support from three kinds of funders",
      "type": "figures",
      "evidence": [
        {
          "text": "Foundation grants provided $640,000 in FY2026.",
          "refs": [
            "P3"
          ]
        },
        {
          "text": "Individual donors gave $388,000.",
          "refs": [
            "P3"
          ]
        },
        {
          "text": "The city's adult education contract paid $295,000.",
          "refs": [
            "P3"
          ]
        },
        {
          "text": "Operating expenses for FY2026 were $1,420,000, with 81 percent going to programs.",
          "refs": [
            "P3"
          ]
        }
      ]
    },
    "ask": {
      "heading": "Help open the sixth site at the Eastgate branch library",
      "amount": "$190,000 more a year, the gap between the staff-recommended FY2027 budget of $1,610,000 and FY2026 expenses of $1,420,000",
      "buys": [
        "A sixth site at the Eastgate branch library",
        "Two more site coordinators"
      ],
      "by_when": "FY2027; the board set its budget vote for October 21",
      "rest": "",
      "report": "Staff estimate the sixth site would serve 180 more learners a year and cut the waitlist in half.",
      "refs": [
        "P3",
        "P5",
        "P8"
      ],
      "none_in_sources": false
    },
    "faults": [],
    "slides_max": 9
  },
