  "passages": {
    "P1": {
      "text": "About Salvia Kitchen",
      "locator": "para. 1",
      "source_title": "About us",
      "source_id": "s_50fada0ac62f"
    },
    "P2": {
      "text": "Salvia Kitchen is Ana and her brother Tomas. We started cooking for neighbors' parties in 2019 and opened our commercial kitchen in 2022.\nLast year we catered 214 events and served about 9,600 guests.\nMost of our business comes from office lunches and baby showers.\nWe buy produce from three farms within 40 miles of the kitchen.",
      "locator": "para. 2",
      "source_title": "About us",
      "source_id": "s_50fada0ac62f"
    },
    "P3": {
      "text": "Salvia Kitchen Catering: Fall Office Menu",
      "locator": "para. 1",
      "source_title": "Fall menu",
      "source_id": "s_db0e032591ed"
    },
    "P4": {
      "text": "Boxed lunches, $16 per person, minimum 10 boxes.\n- Roasted squash and farro salad with sage brown butter, toasted pepitas\n- Chicken mole torta on a bolillo roll, with pickled red onion\n- Grilled vegetable torta with black bean spread (vegan)\nEach box comes with a seasonal side and a piece of piloncillo shortbread.",
      "locator": "para. 2",
      "source_title": "Fall menu",
      "source_id": "s_db0e032591ed"
    },
    "P5": {
      "text": "Family-style trays, $24 per person, minimum 15 guests.\n- Braised short rib with ancho and orange, cilantro rice, charro beans\n- Lemon-herb roast chicken, roasted root vegetables, green salad\nTrays serve 15, 25 or 40 guests.",
      "locator": "para. 3",
      "source_title": "Fall menu",
      "source_id": "s_db0e032591ed"
    },
    "P6": {
      "text": "Add-ons: agua fresca by the gallon, $28. Churro bites, $3 per person.",
      "locator": "para. 4",
      "source_title": "Fall menu",
      "source_id": "s_db0e032591ed"
    },
    "P7": {
      "text": "We need 72 hours notice for orders. Delivery is free within 10 miles of downtown; $35 beyond that.\nEvery menu can be made gluten-free on request. We label all eight major allergens.\nOrder by phone at 555-0142 or at salviakitchen.example.",
      "locator": "para. 5",
      "source_title": "Fall menu",
      "source_id": "s_db0e032591ed"
    }
  },
