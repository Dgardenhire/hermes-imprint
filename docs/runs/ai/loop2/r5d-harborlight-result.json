  "guide": {
    "by": "Written by your Hermes model",
    "guide": [
      {
        "text": "The sources are Harborlight's FY26 program report and notes from a September 13 board retreat.",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_a2e6f04a2007"
          },
          {
            "ref": "P6",
            "n": 2,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 1",
            "source_id": "s_e670c2eaf898"
          }
        ]
      },
      {
        "text": "Harborlight enrolled 1,148 adult learners in FY2026, up from 936 the year before, and 71 earned a high school equivalency credential.",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_a2e6f04a2007"
          }
        ]
      },
      {
        "text": "At year end, 287 adults were on the waitlist, and the average wait was nine weeks.",
        "chips": [
          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_a2e6f04a2007"
          }
        ]
      },
      {
        "text": "Staff recommend an FY2027 budget of $1,610,000 to add a sixth site at the Eastgate branch library and two site coordinators.",
        "chips": [
          {
            "ref": "P5",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_a2e6f04a2007"
          }
        ]
      },
      {
        "text": "Reserves stand at 3.2 months of operating expenses, below the board's 4-month target, and the board will vote on October 21.",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_e670c2eaf898"
          }
        ]
      }
    ],
    "asks": [
      {
        "id": "a1",
        "who": "The board",
