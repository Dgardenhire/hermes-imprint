  "passages": {
    "P1": {
      "text": "In fiscal year 2026, Harborlight enrolled 1,148 adult learners across five neighborhood sites, up from 936 the year before. Of those learners, 412 were working toward a high school equivalency credential and 389 were English language learners.\nSixty-eight percent of learners who stayed at least 12 weeks gained one or more reading levels on the CASAS assessment. Seventy-one learners earned a high school equivalency credential, the most in the organization's history.",
      "locator": "“Who we served”",
      "source_title": "FY26 Program Report",
      "source_id": "s_79c64f0bba36"
    },
    "P2": {
      "text": "A corps of 214 volunteer tutors gave 9,870 tutoring hours. The average tutor stayed 14 months. Harborlight employs 11 full-time staff, including four site coordinators.",
      "locator": "“Volunteers and staff”",
      "source_title": "FY26 Program Report",
      "source_id": "s_79c64f0bba36"
    },
    "P3": {
      "text": "Operating expenses for FY2026 were $1,420,000. Program costs were 81 percent of spending. Foundation grants provided $640,000, individual donors gave $388,000, and the city's adult education contract paid $295,000.\nThe cost per learner was $1,237.",
      "locator": "“Money”",
      "source_title": "FY26 Program Report",
      "source_id": "s_79c64f0bba36"
    },
    "P4": {
      "text": "At year end, 287 adults were on the waitlist, most of them at the Eastgate and Riverside sites. The average wait was nine weeks.",
      "locator": "“The waitlist”",
      "source_title": "FY26 Program Report",
      "source_id": "s_79c64f0bba36"
    },
    "P5": {
      "text": "Staff recommend that the board approve an FY2027 budget of $1,610,000, which adds a sixth site at the Eastgate branch library and two site coordinators. Staff estimate the sixth site would serve 180 more learners a year and cut the waitlist in half.\n“I read my granddaughter a bedtime story for the first time this spring,” said a learner at the Riverside site.",
      "locator": "“Recommendation to the board”",
      "source_title": "FY26 Program Report",
      "source_id": "s_79c64f0bba36"
    },
    "P6": {
      "text": "Board retreat notes, September 13",
      "locator": "para. 1",
      "source_title": "Board retreat notes",
      "source_id": "s_b471a0561699"
    },
    "P7": {
      "text": "Present: board chair Lorraine Okafor, treasurer Dev Patel, executive director Marcus Bell, communications director Denise Alvarez, six board members.",
      "locator": "para. 2",
      "source_title": "Board retreat notes",
      "source_id": "s_b471a0561699"
    },
    "P8": {
      "text": "The treasurer reported that reserves stand at 3.2 months of operating expenses, below the board's target of 4 months.\nThe board asked staff to bring a one-page summary of the FY2027 budget request to the October 21 board meeting.\nBoard members asked for a short deck they can use with funders when they talk about the sixth site.\nThe board agreed to vote on the FY2027 budget on October 21.",
      "locator": "para. 3",
      "source_title": "Board retreat notes",
      "source_id": "s_b471a0561699"
    }
  },
