    "questions": [
      {
        "text": "Reserves are 3.2 months against a 4-month target. Can Harborlight raise spending by $190,000, from $1,420,000 to $1,610,000, without falling further behind?",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_f81d8ed08586"
          },
          {
            "ref": "P3",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_5533fe264b8f"
          },
          {
            "ref": "P5",
            "n": 3,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_5533fe264b8f"
          }
        ],
        "suggestion": true
      },
      {
        "text": "The waitlist holds 287 adults. If the sixth site serves 180 more learners a year, why do staff expect it only to cut the waitlist in half?",
