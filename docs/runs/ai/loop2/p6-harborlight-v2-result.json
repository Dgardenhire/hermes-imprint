    ],
    "questions": [
      {
        "text": "Reserves are 3.2 months against a 4-month target. The budget would rise $190,000, from $1,420,000 to $1,610,000. How will Harborlight pay for that without drawing reserves lower?",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_9b26e251642b"
          },
          {
            "ref": "P3",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_73e6e91acad3"
          },
          {
            "ref": "P5",
            "n": 3,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_73e6e91acad3"
          }
        ],
        "suggestion": true
      },
      {
        "text": "The sixth site would serve 180 more learners a year, but 287 adults are waiting. Is cutting the waitlist in half enough, given most wait at Eastgate and Riverside?",
        "chips": [
          {
            "ref": "P5",
            "n": 1,
            "source_n": 1,
