    "questions": [
      {
        "text": "Reserves are 3.2 months against a 4-month target. Can the board approve a budget that rises $190,000, from $1,420,000 to $1,610,000?",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_adf42f19debd"
          },
          {
            "ref": "P3",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_cd892530a4df"
          },
          {
            "ref": "P5",
            "n": 3,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_cd892530a4df"
          }
        ],
        "suggestion": true
      },
      {
        "text": "The sixth site would serve 180 more learners a year. Is that enough to cut a 287-person waitlist in half, when the wait averages nine weeks?",
