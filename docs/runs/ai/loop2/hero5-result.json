  "guide": {
    "by": "Written by your Hermes model",
    "guide": [
      {
        "text": "These sources are Harborlight's FY26 program report and notes from a September 13 board retreat.",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_13262f7b04a6"
          },
          {
            "ref": "P6",
            "n": 2,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 1",
            "source_id": "s_0ea36c78e815"
          }
        ]
      },
      {
        "text": "Harborlight enrolled 1,148 adult learners in fiscal year 2026, up from 936 the year before.",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_13262f7b04a6"
          }
        ]
      },
      {
        "text": "Still, 287 adults were on the waitlist at year end, and the average wait was nine weeks.",
        "chips": [
          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_13262f7b04a6"
          }
        ]
      },
      {
        "text": "Staff ask the board to approve an FY2027 budget of $1,610,000 that adds a sixth site at the Eastgate branch library.",
        "chips": [
          {
            "ref": "P5",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_13262f7b04a6"
          }
        ]
      },
      {
        "text": "Reserves stand at 3.2 months of operating expenses, below the board's target of 4 months, and the board votes on October 21.",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_0ea36c78e815"
          }
        ]
      }
    ],
    "asks": [
      {
        "id": "a1",
        "who": "The board",
        "what": "One-page summary of the FY2027 budget request",
        "by": "the October 21 board meeting",
        "kind": "onepager",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_0ea36c78e815"
          }
        ],
        "brief": {
          "who": "Harborlight board members",
          "goal": "Decide whether to approve the FY2027 budget",
          "length": "One page"
        }
      },
      {
        "id": "a2",
        "who": "Board members",
        "what": "Short deck for talking with funders about the sixth site",
        "by": "",
        "kind": "deck",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_0ea36c78e815"
          }
        ],
        "brief": {
          "who": "Funders hearing from board members",
          "goal": "Understand and support the sixth site",
          "length": "A short deck"
        }
      }
    ],
    "questions": [
      {
        "text": "The sixth site would serve 180 more learners a year, but 287 adults are waiting. Is cutting the waitlist in half enough when the average wait is nine weeks?",
        "chips": [
          {
            "ref": "P5",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_13262f7b04a6"
          },
          {
            "ref": "P4",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_13262f7b04a6"
          }
        ],
        "suggestion": true
      },
      {
        "text": "Harborlight has 11 full-time staff and four site coordinators. Will two more coordinators and 214 volunteer tutors be enough to serve 180 more learners?",
        "chips": [
          {
            "ref": "P2",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Volunteers and staff”",
            "source_id": "s_13262f7b04a6"
          },
          {
            "ref": "P5",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_13262f7b04a6"
          }
        ],
        "suggestion": true
      }
    ],
