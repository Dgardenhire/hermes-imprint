  "guide": {
    "by": "Written by your Hermes model",
    "guide": [
      {
        "text": "The sources are Harborlight's FY2026 program report and notes from a September 13 board retreat.",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_70da3a0d3ff8"
          },
          {
            "ref": "P6",
            "n": 2,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 1",
            "source_id": "s_295fcef9a768"
          }
        ]
      },
      {
        "text": "Harborlight enrolled 1,148 adult learners in FY2026, up from 936, and 71 earned a high school equivalency credential.",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_70da3a0d3ff8"
          }
        ]
      },
      {
        "text": "Operating expenses were $1,420,000, and 287 adults were still on the waitlist at year end.",
        "chips": [
          {
            "ref": "P3",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_70da3a0d3ff8"
          },
          {
            "ref": "P4",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_70da3a0d3ff8"
          }
        ]
      },
      {
        "text": "Staff ask the board to approve a $1,610,000 FY2027 budget that adds a sixth site at the Eastgate branch library.",
        "chips": [
          {
            "ref": "P5",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_70da3a0d3ff8"
          }
        ]
      },
      {
        "text": "Reserves stand at 3.2 months of operating expenses, below the 4-month target, and the board votes on October 21.",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_295fcef9a768"
          }
        ]
      }
    ],
    "asks": [
