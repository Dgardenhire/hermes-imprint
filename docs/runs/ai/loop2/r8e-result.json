    ],
    "questions": [
      {
        "text": "Reserves are 3.2 months against a 4-month target. Can the board raise spending by $190,000, from $1,420,000 to $1,610,000, without falling further behind?",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_295fcef9a768"
          },
          {
            "ref": "P3",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_70da3a0d3ff8"
          },
          {
            "ref": "P5",
            "n": 3,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_70da3a0d3ff8"
          }
        ],
        "suggestion": true
      },
      {
        "text": "The waitlist holds 287 adults, and the sixth site would serve 180 more learners a year. Why do staff expect it to cut the waitlist only in half?",
        "chips": [
          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_70da3a0d3ff8"
          },
          {
            "ref": "P5",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_70da3a0d3ff8"
          }
        ],
        "suggestion": true
      },
      {
        "text": "Harborlight has 11 full-time staff, including four site coordinators. Will two more coordinators be enough to run a sixth site?",
        "chips": [
          {
            "ref": "P2",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Volunteers and staff”",
