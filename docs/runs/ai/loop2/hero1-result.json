            "source_id": "s_f36d83009515"
          }
        ],
        "brief": {
          "who": "Funders hearing from board members",
          "goal": "Support the new sixth site at Eastgate branch library",
          "length": "A short deck"
        }
      }
    ],
    "questions": [
      {
        "text": "Reserves are 3.2 months against a 4-month target. The budget would rise $190,000, from $1,420,000 to $1,610,000. How will Harborlight pay for that without drawing reserves further down?",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_f36d83009515"
          },
          {
            "ref": "P3",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_aaffecc91318"
          },
          {
            "ref": "P5",
            "n": 3,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_aaffecc91318"
          }
        ],
        "suggestion": true
      },
      {
        "text": "The sixth site would serve 180 more learners a year, but 287 adults are waiting. Is cutting the waitlist in half enough when most waiters are at Eastgate and Riverside?",
        "chips": [
          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
