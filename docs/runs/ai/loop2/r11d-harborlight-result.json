            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_6879ca601c0b"
          }
        ],
        "brief": {
          "who": "Harborlight board members",
          "goal": "Vote on the FY2027 budget request",
          "length": "One page"
        }
      },
      {
        "id": "a2",
        "who": "Board members",
        "what": "Short deck about the sixth site for funder talks",
        "by": "",
        "kind": "deck",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_6879ca601c0b"
          }
        ],
        "brief": {
          "who": "Funders hearing from board members",
          "goal": "Support the new sixth site at Eastgate",
          "length": "A short deck"
        }
      }
    ],
    "questions": [
      {
        "text": "Reserves are 3.2 months of operating expenses, short of the 4-month target. Can the board raise spending $190,000, from $1,420,000 to $1,610,000, without weakening reserves further?",
        "chips": [
          {
            "ref": "P8",
            "n": 1,
            "source_n": 2,
            "source": "Board retreat notes",
            "locator": "para. 3",
            "source_id": "s_6879ca601c0b"
          },
          {
            "ref": "P3",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Money”",
            "source_id": "s_d91ff0b6a962"
          },
          {
            "ref": "P5",
            "n": 3,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_d91ff0b6a962"
          }
        ],
        "suggestion": true
      },
      {
        "text": "The waitlist holds 287 adults. If the sixth site serves 180 more learners a year, why do staff expect it to cut the waitlist only in half?",
        "chips": [
          {
            "ref": "P4",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“The waitlist”",
            "source_id": "s_d91ff0b6a962"
          },
          {
            "ref": "P5",
            "n": 2,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Recommendation to the board”",
            "source_id": "s_d91ff0b6a962"
          }
        ],
        "suggestion": true
      },
      {
        "text": "Enrollment grew from 936 to 1,148 learners, yet 287 adults still wait an average of nine weeks. Will one more site keep up with demand?",
        "chips": [
          {
            "ref": "P1",
            "n": 1,
            "source_n": 1,
            "source": "FY26 Program Report",
            "locator": "“Who we served”",
            "source_id": "s_d91ff0b6a962"
          },
